# ============================================================================
# TruthVortex — Backend environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp backend/.env.example backend/.env
# On Render, set the `sync: false` values in the dashboard (not in git).
# ============================================================================

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Preferred: a single connection string. On Render this is injected
# automatically from the managed database (see render.yaml).
DATABASE_URL=postgresql://user:password@localhost:5432/newsdb

# Optional discrete fields (used only if DATABASE_URL is not set):
# DB_NAME=newsdb
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
DB_POOL_MAX=5

# ----------------------------------------------------------------------------
# AI provider (OpenAI-compatible)
# ----------------------------------------------------------------------------
# Preferred provider to try FIRST: "openrouter", "groq", "gemini", or "nvidia".
# You do NOT have to match this to the key you set — the scraper auto-detects
# whichever keys below are present and uses them as a fallback chain in this
# order: openrouter, openrouter2, groq, nvidia, gemini. Set just ONE to start.
AI_PROVIDER=openrouter

# OpenRouter API keys (https://openrouter.ai/keys) — SECRET. Two supported for
# redundancy (the scraper rotates to the 2nd on rate limits). Free models work.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
# Instruction-tuned free model (clean Telugu, no reasoning-trace leakage).
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Groq API key (https://console.groq.com/keys) — SECRET. Free + fast. Fallback.
GROQ_API_KEY=

# Gemini API key (https://aistudio.google.com/apikey) — SECRET. Must start with "AIza".
GEMINI_API_KEY=

# NVIDIA API key (https://build.nvidia.com) — SECRET. Optional fallback.
NVIDIA_API_KEY=

# Advanced overrides (leave unset to use provider defaults):
#   openrouter -> OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
#   groq       -> AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   nvidia     -> AI_BASE_URL=https://integrate.api.nvidia.com/v1  AI_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

# ----------------------------------------------------------------------------
# Summaries
# ----------------------------------------------------------------------------
ENABLE_AI_SUMMARY=true
# Language for AI summaries (6–10 line summaries are produced in this language).
SUMMARY_LANGUAGE=Telugu
# Legacy machine translation step (kept off; summaries are generated directly).
ENABLE_TRANSLATION=false
MIN_AI_SUMMARY_CHARS=40
# AI can summarize an RSS description when full article text extraction fails.
MIN_AI_INPUT_CHARS=80
MIN_FULL_ARTICLE_CHARS=250

# ----------------------------------------------------------------------------
# Images
# ----------------------------------------------------------------------------
# Sources here are hand-curated to be logo/watermark-free, so keep the real
# source photo by default. Set to true to always use the placeholder instead.
SAFE_IMAGES_ONLY=false
SKIP_PAGE_IMAGE_EXTRACTION=false

# ----------------------------------------------------------------------------
# Scraper tuning
# ----------------------------------------------------------------------------
# Set on the API service in any deployment where a separate cron owns scraping
# (see render.yaml). Without it the API's in-process thread scrapes every 30 min
# alongside the cron, doubling LLM spend and rate-limit pressure. Leave unset
# locally if you want `uvicorn main:app` alone to populate the DB.
# DISABLE_BACKGROUND_SCRAPER=true
MAX_CONCURRENT_SOURCES=5
MAX_ENTRIES_PER_SOURCE=6
# Minimum gap between two requests to the same publisher host. Feeds are fetched
# from a thread pool and several sources can share one host, so without a floor
# here that publisher gets simultaneous hits and starts 429ing. 0 = no pacing.
PER_DOMAIN_DELAY_SECONDS=0.5
# Retry a bot-walled fetch (403/429/503 from Cloudflare/Akamai) once with a real
# browser TLS fingerprint via curl_cffi. Some CDNs block on fingerprint rather
# than headers, so no amount of header tuning is an alternative. Failure-
# triggered only — the happy path never pays for it.
ENABLE_IMPERSONATE_FALLBACK=true
# curl_cffi browser profile. "chrome" tracks the newest build the installed
# curl_cffi knows about; pinning an old build is what gets a profile blocklisted.
IMPERSONATE_PROFILE=chrome
# Articles older than this many days are deleted at the start of every scrape
# cycle, and feed entries already this old are never ingested. 0 = keep forever.
ARTICLE_RETENTION_DAYS=2
REQUEST_TIMEOUT=12
ARTICLE_TEXT_TIMEOUT=10
PAGE_IMAGE_TIMEOUT=6
# Used only by check_feeds.py (feed-liveness checker).
CHECK_WORKERS=8

# ----------------------------------------------------------------------------
# Security / CORS
# ----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins. NEVER use "*" in production.
# Local dev default below; in production set to your Vercel domain(s), e.g.
#   CORS_ALLOW_ORIGINS=https://your-app.vercel.app,https://www.yourdomain.com
CORS_ALLOW_ORIGINS=http://localhost:3000
