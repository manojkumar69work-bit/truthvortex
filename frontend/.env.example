# ============================================================================
# TruthVortex — Frontend environment variables (Next.js)
# Copy to `.env.local` for local dev. NEVER commit real `.env*` files.
#   cp frontend/.env.example frontend/.env.local
#
# NOTE: Only NON-SECRET values belong in NEXT_PUBLIC_* vars — they are exposed
# to the browser. Never put API keys or secrets here.
# ============================================================================

# Base URL of the backend /news endpoint.
# Local dev default is http://127.0.0.1:8000/news
# In production set to your Render backend, e.g.
#   NEXT_PUBLIC_API_URL=https://truthvortex-api.onrender.com/news
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/news

# Public site URL, used for SEO / Open Graph metadata (absolute URLs).
# In production set to your Vercel domain, e.g.
#   NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
